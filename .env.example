OPENAI_API_KEY=your_openai_api_key

# SMTP email alert settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com
SMTP_TO=receiver@example.com
SMTP_USE_TLS=true

# Optional owner routing. If configured, category-specific alerts go to these owners.
OWNER_DOCKER=DevOps / Platform
OWNER_EMAIL_DOCKER=devops@example.com
OWNER_KUBERNETES=DevOps / Platform
OWNER_EMAIL_KUBERNETES=devops@example.com
OWNER_HELM=DevOps / Platform
OWNER_EMAIL_HELM=devops@example.com
OWNER_NPM=Application Team
OWNER_EMAIL_NPM=app-team@example.com
OWNER_PYTHON=Application Team
OWNER_EMAIL_PYTHON=app-team@example.com
OWNER_SECURITY=Security Team
OWNER_EMAIL_SECURITY=security@example.com

# Optional read-only source inspection. The agent reads small snippets only and never writes.
ENABLE_CODE_CONTEXT=false
APP_READONLY_DIR=/Users/harishkumarr/Desktop/justo-sample-app/node-postgres-app
